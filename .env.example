# Settings for your agent. The setup script copies this file to .env.
# Edit .env, not this file. Never share or commit .env: it holds your keys.

# Which model provider to use: anthropic, openai, compatible or fake.
# If the provider you choose has no key below, the agent uses the fake model.
PROVIDER=anthropic

# Model name. Leave blank to use the provider's default.
MODEL=

# Paste the key for the provider you chose.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PROVIDER=compatible: any service with an OpenAI-style address, for example
# DeepSeek, Qwen, Kimi or GLM. Set all three of these, and MODEL above.
# docs/GUIDE.md lists the address for each.
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# The most steps the agent may take for one message before it stops.
MAX_STEPS=10
